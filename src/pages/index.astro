---
import BaseLayout from '../layouts/BaseLayout.astro'
import SectionLabel from '../components/SectionLabel.astro'
import EnquiryForm from '../components/EnquiryForm.jsx'
import TestimonialSlider from '../components/TestimonialSlider.jsx'
import { services, languages, testimonials, videoSamples } from '../data/site.ts'
const title='REVERB Inc. — Voice Overs, Dubbing & Localization in India'
const description='Bengaluru language and content studio for voice overs, dubbing, localization, micro drama and original content across 22+ languages.'
---
<BaseLayout {title} {description} schema={{'@context':'https://schema.org','@type':'WebSite','@id':'https://wereverb.com/#website',name:'REVERB Inc.',url:'https://wereverb.com/'}}>
  <section class="hero"><div><small>REVERB INC. · BENGALURU, INDIA</small><h1>The world has <em>stories</em> to tell. We help everyone hear—and see—them in the language they call <em>their own.</em></h1><p>A language and content studio built on voice, craft, and a native understanding of every audience.</p><a class="text-link" href="/contact/">Start a project →</a></div><div class="formation-logo hero-brand"><img src="/reverb-logo.png" alt=""/><b>REVERB</b></div></section>
  <section class="section"><SectionLabel number="01" label="The studio"/><div class="studio-grid"><h3>Not just translated.<br/><em>Truly understood.</em></h3><div><p>REVERB Inc. is a Bengaluru-based language and content studio built for audiences who deserve a native listen—not just a translation.</p><div class="stats"><b>1000+<small>Projects</small></b><b>22+<small>Languages</small></b><b>20<sup>yrs</sup><small>Craft</small></b></div></div></div></section>
  <section class="section"><SectionLabel number="02" label="Meet the founder"/><div class="founder-grid"><img class="founder-photo" src="/images/pradeep-badekkila-transparent.png" srcset="/images/pradeep-badekkila-transparent-640.png 640w, /images/pradeep-badekkila-transparent.png 1024w" sizes="(max-width: 800px) 90vw, 38vw" alt="Pradeep Badekkila, founder of REVERB Inc." width="1024" height="1280" loading="lazy" decoding="async"/><div class="founder-copy"><h3>Pradeep <em>Badekkila.</em></h3><p class="founder-kicker">Some voices you hear. His, you recognize.</p><p>For twenty years, Pradeep Badekkila has lived inside the space between a language and the person listening to it—as a multilingual voice artist, producer, and presenter across television and radio, and as the voice that guides millions of Bengaluru commuters home every day on Namma Metro.</p><p>REVERB Inc. is what that career became: a studio built on the belief that a good voice-over isn&rsquo;t translated, it&rsquo;s <em>felt</em>—in whichever of India&rsquo;s languages an audience calls their own.</p><a class="text-link" href="/about/pradeep-badekkila/">Read Pradeep’s story →</a></div></div></section>
  <section class="section"><SectionLabel number="03" label="Our services"/><div class="cards">{services.map(service=><a class="card" href={`/services/${service.slug}/`}><h3>{service.title}</h3><p>{service.short}</p><span>Explore service →</span></a>)}</div></section>
  <section class="section"><SectionLabel number="04" label="Selected work"/><div class="section-heading"><h3>Stories made to<br/><em>travel further.</em></h3><a class="text-link" href="/work/">View all work →</a></div><div class="video-grid">{videoSamples.slice(0,2).map((video,index)=><article class="video-card"><video controls preload="none" poster={video.poster} playsinline aria-label={`${video.title}, ${video.language}`}><source src={video.src} type="video/mp4"/></video><div class="video-meta"><span>0{index+1} · {video.type}</span><h3>{video.title}</h3><p>{video.language}<small>{video.duration}</small></p></div></article>)}</div></section>
  <section class="section"><SectionLabel number="05" label="Languages"/><div class="language-grid">{languages.map(([name,native])=><span>{name}<em>{native}</em></span>)}</div></section>
  <section class="section"><SectionLabel number="06" label="Client voices"/><div class="section-heading"><h3>Work that earns<br/><em>lasting trust.</em></h3><p>Replace these content-safe placeholders with approved client quotations before launch.</p></div><TestimonialSlider client:visible items={testimonials}/></section>
  <section class="section"><SectionLabel number="07" label="Start a project"/><div class="section-heading"><h3>Tell us what<br/><em>you’re making.</em></h3></div><EnquiryForm client:visible sourcePage="/"/></section>
</BaseLayout>
