---
import BaseLayout from '../../layouts/BaseLayout.astro';import {videoSamples} from '../../data/site.ts'
const schema={'@context':'https://schema.org','@type':'ItemList',name:'REVERB selected video work',itemListElement:videoSamples.map((video,index)=>({'@type':'ListItem',position:index+1,item:{'@type':'VideoObject',name:video.title,description:`${video.type} in ${video.language}`,thumbnailUrl:new URL(video.poster,Astro.site).href,contentUrl:new URL(video.src,Astro.site).href,duration:`PT${video.duration.split(':')[0]}M${video.duration.split(':')[1]}S`,uploadDate:'2026-09-08'}}))}
---
<BaseLayout title="Selected Work and Demo Reels | REVERB Inc." description="Explore selected voice, dubbing, localization and campaign work across Kannada, Gujarati, English and Tamil." {schema}><section class="page-hero"><h1>Work you can <em>hear and feel.</em></h1><p>Selected multilingual voice, localization and campaign samples from REVERB.</p></section><section class="section"><div class="video-grid">{videoSamples.map((video,index)=><article class="video-card"><video controls preload="none" poster={video.poster} playsinline aria-label={`${video.title}, ${video.language}`}><source src={video.src} type="video/mp4"/>Your browser does not support embedded video.</video><div class="video-meta"><span>0{index+1} · {video.type}</span><h2>{video.title}</h2><p>{video.language}<small>{video.duration}</small></p></div></article>)}</div></section></BaseLayout>
